# Copy to .env and adjust.
PGA_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pga
# Tests create/drop their own tables here (and a scratch DB for the migration test).
PGA_TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pga_test

# "anthropic" for real models, "fake" to run fully offline.
PGA_LLM_PROVIDER=fake
ANTHROPIC_API_KEY=

# Optional: your own policy file, merged over src/pga/policy.yaml.
# PGA_POLICY_FILE=my-policy.yaml
