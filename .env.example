# Copy to .env and adjust.
PGA_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pga
# Tests create/drop their own tables here (and a scratch DB for the migration test).
PGA_TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/pga_test

# "anthropic" (API key), "deepseek" (API key), "claude_cli" (your Claude Pro/Max
# subscription through the logged-in `claude` CLI, no key needed), or "fake" (offline).
PGA_LLM_PROVIDER=fake
ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=          # only for a relay/proxy; leave unset for api.anthropic.com
DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com

# Optional: your own policy file, merged over src/pga/policy.yaml.
# PGA_POLICY_FILE=my-policy.yaml

# Knowledge vault (Obsidian format). Export target, and optionally your own vault to show read-only.
# PGA_VAULT_DIR=~/PGA Vault
# PGA_OBSIDIAN_VAULT=~/Documents/Obsidian/MyVault
